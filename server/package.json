{
  "name": "alumni-event-api",
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx watch index.ts",
    "start": "tsx index.ts",
    "build": "tsc --noEmit",
    "check:env": "node scripts/check-env.mjs",
    "security:rotate-admin": "node scripts/rotate-admin-password.mjs",
    "load:test": "node scripts/load-test.mjs",
    "cleanup:samples": "node scripts/cleanup-sample-data.mjs",
    "migrate": "node run-migration.mjs",
    "test": "tsx --test tests/hardening.test.mjs tests/security-policy.test.ts",
    "smoke": "node scripts/smoke-api.mjs",
    "install:chrome": "echo 'Skipping puppeteer browser install (using @sparticuz/chromium).'",
    "postinstall": "npm run install:chrome",
    "seed": "tsx seed.ts"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "dependencies": {
    "@sparticuz/chromium": "^148.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.22.0",
    "nodemailer": "^8.0.7",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.8.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0"
  }
}
