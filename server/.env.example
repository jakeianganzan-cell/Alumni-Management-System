# Runtime
NODE_ENV=development
APP_ENV=development
PORT=5000
HOST=0.0.0.0

# Browser origins. Use comma-separated deployed frontend origins in production.
FRONTEND_URL=http://localhost:8080
APP_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080
CLIENT_ORIGIN=
CORS_ALLOW_ALL=false
API_RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=10
LOGIN_ACCOUNT_RATE_LIMIT_MAX=5
PUBLIC_SUBMISSION_RATE_LIMIT_MAX=5
IMPORT_RATE_LIMIT_MAX=5
TRUST_PROXY_HOPS=0
CSP_CONNECT_ORIGINS=

# Database
# Safety: when NODE_ENV=test, DB_NAME must end in _test, _ci, or _staging.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ustp_alumni
DB_ENVIRONMENT=development
DB_SSL=false
DB_SSL_CA=
DB_SSL_CA_FILE=
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX_IDLE=15
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_LIMIT=25
DB_POOL_QUEUE_LIMIT=250

# Backup tooling (use a separate least-privilege backup account in automation).
# Generate BACKUP_ENCRYPTION_KEY with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=
BACKUP_FILE=

# Restore tooling. Only set these temporarily for a disposable recovery database.
RESTORE_DB_HOST=
RESTORE_DB_PORT=3306
RESTORE_DB_USER=
RESTORE_DB_PASSWORD=
RESTORE_DB_NAME=
RESTORE_DB_SSL=false
RESTORE_DB_SSL_CA=
RESTORE_DB_SSL_CA_FILE=
RESTORE_CONFIRM_DATABASE=
ALLOW_DATABASE_RESTORE=NO

# Authentication. Generate unique values; never commit real credentials.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d
ADMIN_EMAIL=admin@example.edu.ph
ADMIN_PASSWORD=replace-with-at-least-12-random-characters
ADMIN_NAME=System Administrator
RESET_ADMIN_PASSWORD_ON_STARTUP=false
SESSION_TOUCH_INTERVAL_MS=60000

# Optional chairman bootstrap credentials
CHAIRMAN_BTLED_PASSWORD=
CHAIRMAN_BECED_PASSWORD=
CHAIRMAN_BSENTREP_PASSWORD=
CHAIRMAN_BSM_PASSWORD=

# Email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Salay Community College
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Background jobs and deployment safety
RUNTIME_SCHEMA_SYNC=true
QUEUE_PROCESSING_ENABLED=true
AUTO_ARCHIVE_ENABLED=true
ENABLE_SETUP_ADMIN=false
ENABLE_TEST_ROUTE=false
# Optional demo seeding only: JSON object with a distinct 12+ character password per account email.
SEED_PASSWORDS_JSON=

# Institution
INSTITUTION_NAME=Salay Community College
INSTITUTION_ACRONYM=SCC

# Optional browser executable overrides
PUPPETEER_EXECUTABLE_PATH=
CHROME_PATH=
